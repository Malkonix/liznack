<?xml version="1.0" encoding="utf-8"?>
<!-- El ícono adaptativo (Android 8+): el mismo 🍬 del portal sobre el caramelo
     suave del tema. El lanzador recorta el fondo con la forma que use (círculo,
     cuadrado redondeado, gota) y por eso el emoji va dentro de la zona segura. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
