# Copiá este archivo a `.env` y ajustá los valores.
# Docker Compose lee `.env` solo, no hace falta exportar nada.

# Contraseña del portal del administrador (http://IP:3000/admin).
# Si la dejás vacía, el portal queda desactivado y la app sigue funcionando.
LIZNACK_ADMIN=cambiame

# Puerto en la máquina anfitriona. El servidor adentro siempre escucha en 3000.
LIZNACK_PUERTO=3000

# 0.0.0.0 = accesible desde los teléfonos de la red local (lo normal).
# 127.0.0.1 = solo desde esta máquina.
LIZNACK_IP=0.0.0.0
